{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/programacao/corrida-de-rua",
      "destination": "/programacao/nb-universitario",
      "permanent": true
    },
    {
      "source": "/precos-bsb",
      "destination": "/ingressos",
      "permanent": true
    },
    {
      "source": "/nutricao-brasil-run",
      "destination": "/corrida",
      "permanent": true
    },
    {
      "source": "/porto-alegre",
      "destination": "/portoalegre",
      "permanent": true
    },
    {
      "source": "/programacao/medbrasil",
      "destination": "/programacao",
      "permanent": true
    },
    {
      "source": "/release2026",
      "destination": "/assets/release-oficial-nb2026.pdf",
      "permanent": false
    },
    {
      "source": "/goiania-vip",
      "destination": "/goiania",
      "permanent": false
    }
  ]
}
